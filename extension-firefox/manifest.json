{
  "manifest_version": 3,
  "name": "Prompt Enhancer",
  "version": "1.0.0",
  "description": "Turn rough drafts into structured, high-quality prompts on ChatGPT, Claude and Gemini using your own API key.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Prompt Enhancer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": [
      "src/shared/namespace.js",
      "src/shared/constants.js",
      "src/shared/errors.js",
      "src/shared/storage.js",
      "src/background/http.js",
      "src/background/providers/openai-compatible.js",
      "src/background/providers/openrouter.js",
      "src/background/providers/opencode.js",
      "src/background/providers/custom.js",
      "src/background/providers/registry.js",
      "src/background/enhancer.js",
      "src/background/service-worker.js"
    ]
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://openrouter.ai/*",
    "https://opencode.ai/*",
    "https://www.perplexity.ai/*",
    "https://chat.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "src/content/content-constants.js",
        "src/content/site-adapters.js",
        "src/content/dom-utils.js",
        "src/content/ui-overlay.js",
        "src/content/stats-overlay.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "enhance-prompt": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Enhance the prompt in the focused chat box"
    },
    "correct-grammar": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Correct grammar of draft text in active chat box"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "prompt-enhancer@zaid.dev",
      "strict_min_version": "115.0"
    }
  },
  "optional_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
